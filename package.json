{
  "name": "@atb-as/planner-web-widget",
  "version": "3.2.3",
  "private": true,
  "license": "EUPL-1.2",
  "packageManager": "pnpm@11.5.2",
  "scripts": {
    "dev": "vite",
    "build": "vite build --emptyOutDir",
    "build:widget": "sh ./scripts/build-widget.sh",
    "build:all-widgets": "sh ./scripts/build-all-widgets.sh",
    "start": "node server.mts",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check-all": "pnpm typecheck && pnpm format:check && pnpm build:all-widgets"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "@github/combobox-nav": "^3.0.1",
    "express": "^4.21.0"
  },
  "devDependencies": {
    "@atb-as/theme": "^15.0.1",
    "@atb-as/token": "^0.0.3",
    "@types/express": "^5.0.6",
    "@types/node": "^25.6.0",
    "compare-versions": "^6.1.1",
    "postcss": "^8.5.6",
    "postcss-cli": "^11.0.1",
    "postcss-flexbugs-fixes": "^5.0.2",
    "postcss-preset-env": "^10.2.4",
    "prettier": "^3.8.3",
    "typescript": "5.9.2",
    "vite": "^7.1.2",
    "vite-plugin-dts": "^4.5.4"
  }
}
